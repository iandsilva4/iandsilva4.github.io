---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout>
	<div class="mt-8 md:mt-16 flex flex-col md:flex-row items-center gap-8 w-full">
		<div class="w-80 h-80 rounded-xl border border-gray-300 shadow mb-6 md:mb-0 overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200">
			<img 
				src="/images/headshot_small_square.png" 
				alt="Headshot" 
				width="400" 
				height="400" 
				class="w-full h-full object-cover object-center" 
				style="image-rendering: auto;"
				loading="eager"
			/>
		</div>
		<div class="flex-1">
			<h1 class="text-3xl font-bold mb-4">About Me</h1>
			<p class="mb-6 text-lg">I am an MBA candidate at Chicago Booth. Previously, I was in Strategy & Operations at Instacart, Strategy Consulting at IBM, and at Duke University.</p>
			<p class="mb-6 text-lg">I am driven by problems at the intersection of strategy & technology.</p>
			<p class="text-base">Check out some of my <a href="/projects/" class="text-blue-600 underline">projects</a> and <a href="/contact/" class="text-blue-600 underline">get in touch</a>.</p>
		</div>
	</div>
</MainLayout>
