---
import MainLayout from '../../layouts/MainLayout.astro';

// Resume data - your actual experience
const resumeData = [
  {
    id: 1,
    title: "Next: TBD?",
    position: "Future Opportunity",
    dates: "2025 - Future",
    description: "Excited for what's next in my career journey. Open to new opportunities in strategy, technology, and innovation.",
    image: "https://via.placeholder.com/400x200/6366f1/ffffff?text=Future+Opportunity",
    icon: "🔮",
    category: "future"
  },
  {
    id: 2,
    title: "Software Growth Partners",
    position: "MBA Intern",
    dates: "Summer 2024",
    description: "MBA internship focused on LLM SaaS buyouts and growth equity investments in software companies.",
    image: "https://via.placeholder.com/400x200/059669/ffffff?text=Software+Growth+Partners",
    icon: "💰",
    category: "investment"
  },
  {
    id: 3,
    title: "Chicago Booth",
    position: "MBA Candidate",
    dates: "2023 - 2025",
    description: "Pursuing MBA with focus on strategy, technology, and innovation. Developing skills in business strategy and leadership.",
    image: "https://via.placeholder.com/400x200/1e40af/ffffff?text=Chicago+Booth",
    icon: "🎓",
    category: "education"
  },
  {
    id: 4,
    title: "Instacart",
    position: "Business Operations",
    dates: "2021 - 2023",
    description: "BizOps role focused on consumer growth and strategic partnerships. Drove operational excellence and growth initiatives.",
    image: "https://via.placeholder.com/400x200/ea580c/ffffff?text=Instacart",
    icon: "🛒",
    category: "operations"
  },
  {
    id: 5,
    title: "IBM",
    position: "Strategy Consultant",
    dates: "2018 - 2021",
    description: "Strategy consultant focused on digital transformations. Helped clients navigate technology-driven business model changes.",
    image: "https://via.placeholder.com/400x200/000000/ffffff?text=IBM",
    icon: "🔧",
    category: "consulting"
  },
  {
    id: 6,
    title: "Duke University",
    position: "Computer Science & Economics",
    dates: "2014 - 2018",
    description: "Studied Computer Science and Economics. Developed strong foundation in both technical and business disciplines.",
    image: "/images/duke-university-wireframe.png",
    icon: "🏫",
    category: "education"
  }
];
---

<MainLayout>
  <div class="min-h-screen py-8 md:py-16">
    <!-- Header Section -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h1 class="display-large mb-6">Professional Timeline</h1>
      <p class="text-body-large text-gray-600 max-w-2xl mx-auto">
        A chronological journey through my professional experience, showcasing key milestones and achievements across strategy, technology, and innovation.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Timeline Line -->
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-500 via-blue-400 to-blue-300 transform md:-translate-x-1/2"></div>

      <!-- Timeline Items -->
      <div class="space-y-12">
        {resumeData.map((item, index) => (
          <div class={`relative flex items-center ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} animate-fade-in-up`} style={`animation-delay: ${index * 0.1}s`}>
            
            <!-- Timeline Dot -->
            <div class="absolute left-8 md:left-1/2 w-4 h-4 bg-blue-500 rounded-full border-4 border-white shadow-lg transform md:-translate-x-1/2 z-10"></div>
            
                         <!-- Content Card -->
             <div class={`ml-16 md:ml-0 md:w-5/12 ${index % 2 === 0 ? 'md:mr-auto md:pr-8' : 'md:ml-auto md:pl-8'}`}>
               <div class="post-card">
                                                      <!-- Image Section -->
                   <div class="post-image lazy-image" data-src={item.image}>
                     <div class="absolute inset-0 bg-gradient-to-br from-blue-500/20 to-purple-500/20 z-10"></div>
                     <div class="absolute inset-0 bg-gray-200 flex items-center justify-center">
                       <span class="text-6xl opacity-20">{item.icon}</span>
                     </div>
                     <!-- Placeholder for actual images - you can replace with real images -->
                     <div class="absolute inset-0 bg-gradient-to-br from-blue-400/30 to-purple-400/30 flex items-center justify-center z-20">
                       <div class="text-center text-white">
                         <div class="text-4xl mb-2">{item.icon}</div>
                         <div class="text-sm font-medium">{item.category}</div>
                       </div>
                     </div>
                   </div>
                 
                                   <!-- Content Section -->
                  <div class="post-content">
                    <div class="mb-4">
                      <h3 class="text-2xl font-bold text-gray-900 mb-1 leading-tight">
                        {item.title}
                      </h3>
                      <div class="text-lg font-medium text-gray-700 mb-1 leading-relaxed">
                        {item.position}
                      </div>
                      <div class="text-sm text-blue-600 font-semibold tracking-wide uppercase">
                        {item.dates}
                      </div>
                    </div>
                    
                    <p class="text-gray-600 text-sm leading-relaxed mb-4">
                      {item.description}
                    </p>
                    
                    <div class="mt-auto">
                      <span class="inline-block px-3 py-1.5 text-sm font-medium bg-blue-100 text-blue-700 rounded-full capitalize">
                        {item.category}
                      </span>
                    </div>
                  </div>
               </div>
             </div>
          </div>
        ))}
      </div>
    </div>

    
  </div>
</MainLayout>

<style>
  /* Post card styles to match presentation/writing cards */
  .post-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(25px) saturate(180%);
    -webkit-backdrop-filter: blur(25px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1.5rem;
    box-shadow: 
      0 8px 32px 0 rgba(31, 38, 135, 0.37),
      0 4px 16px 0 rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    isolation: isolate;
  }
  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(255, 255, 255, 0.02) 100%);
    border-radius: 1.5rem;
    pointer-events: none;
    z-index: 1;
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 40px 0 rgba(31, 38, 135, 0.4),
      0 8px 24px 0 rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    background: #f3f4f6;
    position: relative;
  }
  .post-content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 1.75rem;
    position: relative;
    z-index: 2;
    height: 100%;
  }
  
  /* Lazy loading styles */
  .lazy-image {
    background-size: cover;
    background-position: center;
    background-color: #f3f4f6;
    position: relative;
  }
  
  .lazy-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
  }
  
     .lazy-image.loaded::before {
     display: none;
   }
   
   .lazy-image.loaded .absolute {
     opacity: 0;
     transition: opacity 0.3s ease-out;
   }
  
  @keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  

  
  /* Enhanced typography for professional cards */
  .post-content h3 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    letter-spacing: -0.025em;
  }
  
  .post-content .text-lg {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    letter-spacing: -0.01em;
  }
  
  .post-content .text-sm {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    letter-spacing: 0.05em;
  }
  
  /* Custom timeline animations */
  .timeline-item {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease-out;
  }
  
  .timeline-item.animate {
    opacity: 1;
    transform: translateY(0);
  }
  
  /* Responsive timeline adjustments */
  @media (max-width: 768px) {
    .timeline-line {
      left: 2rem;
    }
    
    .timeline-dot {
      left: 2rem;
      transform: translateX(-50%);
    }
  }
</style>

<script>
  // Intersection Observer for timeline animations and lazy loading
  if (typeof window !== 'undefined') {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate');
        }
      });
    }, observerOptions);

    // Observe timeline items
    document.querySelectorAll('.timeline-item').forEach(item => {
      observer.observe(item);
    });
    
         // Lazy loading for images
     const lazyImages = document.querySelectorAll('.lazy-image');
     const imageObserver = new IntersectionObserver((entries, observer) => {
       entries.forEach(entry => {
         if (entry.isIntersecting) {
           const img = entry.target as HTMLElement;
           const src = img.getAttribute('data-src');
           if (src) {
             console.log('Loading image:', src);
             img.style.backgroundImage = `url(${src})`;
             img.classList.add('loaded');
             observer.unobserve(img);
           }
         }
       });
     }, {
       rootMargin: '50px 0px',
       threshold: 0.1
     });
     
     lazyImages.forEach(img => imageObserver.observe(img));
  }
</script> 